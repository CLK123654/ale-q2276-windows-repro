{
  "criteria_version": "autoclave-release-2.0",
  "physical_constants": {
    "gas_constant_j_mol_k": 8.314462618,
    "reaction_enthalpy_j_kg": 280000
  },
  "initial_state": {
    "part_temp_c": 25,
    "cure_degree": 0.02
  },
  "model": {
    "cure_rate": "A_s_1*exp(-Ea_j_mol/(R*(part_temp_c+273.15)))*(1-cure_degree)^reaction_order_n",
    "part_temperature_rate": "(air_temp_c-part_temp_c)/(tau_s*tau_multiplier)+beta_c_per_alpha*cure_rate",
    "heat_flow_w_kg": "reaction_enthalpy_j_kg*cure_rate"
  },
  "calibration": {
    "temperature_resolution_c": 0.1,
    "heat_flow_resolution_w_kg": 0.5,
    "score": "sum_over_runs((temperature_rmse_c/temperature_resolution_c)^2+(heat_flow_rmse_w_kg/heat_flow_resolution_w_kg)^2)",
    "selection_order": [
      "total_score ASC",
      "model_id ASC"
    ]
  },
  "solver": {
    "max_step_s": 5,
    "relative_tolerance": 1e-8,
    "absolute_tolerance": 1e-10
  },
  "program": {
    "cool_end_c": 60,
    "profile_interval_s": 300
  },
  "constraints": {
    "final_cure_degree_min": 0.94,
    "cure_degree_at_cool_start_min": 0.9,
    "peak_part_temp_c_max": 185,
    "max_positive_part_minus_air_c_before_cool_max": 12,
    "max_air_minus_part_c_during_ramp_max": 25,
    "cycle_min_max": 235
  },
  "energy_model": {
    "ambient_c": 25,
    "base_kw": 8,
    "temperature_kw_per_c": 0.18,
    "positive_ramp_kw_per_c_min": 3
  },
  "selection": {
    "feasible_only": true,
    "order": [
      "cost_yuan ASC",
      "energy_kwh ASC",
      "cycle_min ASC",
      "program_id ASC"
    ]
  },
  "rounding": {
    "temperature_c": 4,
    "cure_degree": 6,
    "rmse": 6,
    "energy_kwh": 6,
    "cost_yuan": 6,
    "cycle_min": 4
  },
  "handoff_tolerance": {
    "temperature_rmse_c": 0.1,
    "heat_flow_rmse_w_kg": 0.5,
    "program_temperature_c": 0.2,
    "cure_degree": 0.002,
    "cycle_min": 0.1,
    "energy_kwh": 0.2,
    "cost_yuan": 0.3
  }
}
